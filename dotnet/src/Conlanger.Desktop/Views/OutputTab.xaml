<UserControl x:Class="Conlanger.Desktop.Views.OutputTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Conlanger.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="780" d:DesignWidth="1200">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <!-- Left Top: Phonotactic Word Generator -->
        <GroupBox Grid.Row="0" Grid.Column="0" Header="Phonotactic Word Generator" Margin="0,0,10,10">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Count:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding WordCount, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="0,0,10,4" />
                    <TextBlock Text="Syllables:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding SyllablesPerWord, UpdateSourceTrigger=PropertyChanged}" Width="46" Margin="0,0,10,4" />
                    <CheckBox Content="Hyphenate" IsChecked="{Binding HyphenateSyllables}" VerticalAlignment="Center" Margin="0,0,10,4" />
                    <CheckBox Content="Allow Duplicates" IsChecked="{Binding AllowDuplicates}" VerticalAlignment="Center" Margin="0,0,10,4" />
                    <Button Content="Generate Words" Command="{Binding GenerateWordsCommand}" Margin="0,0,0,4" />
                </WrapPanel>
                <TextBox Text="{Binding GeneratedWordsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Background="#F8FAFC" />
            </DockPanel>
        </GroupBox>

        <!-- Right Top: Batch Sentence Corpus & Export -->
        <GroupBox Grid.Row="0" Grid.Column="1" Header="Full Pipeline Batch Sentence Corpus &amp; Export" Margin="0,0,0,10">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Samples (N):" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding SampleCount, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="0,0,10,4" />
                    <TextBlock Text="Approx Words:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding OutputApproxWords, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="0,0,10,4" />
                    <TextBlock Text="Seed:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding OutputSeedText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,10,4" />
                    <TextBlock Text="Constraint:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding ConstraintFeatName, UpdateSourceTrigger=PropertyChanged}" Width="68" ToolTip="Feature Name" Margin="0,0,4,4" />
                    <TextBlock Text="=" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding ConstraintFeatVal, UpdateSourceTrigger=PropertyChanged}" Width="64" ToolTip="Feature Value" Margin="0,0,10,4" />
                    <TextBlock Text="Mood:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <ComboBox ItemsSource="{Binding SyntaxMoodOptions}" SelectedItem="{Binding OutputMoodFilter}" Width="105" Margin="0,0,10,4" />
                    <TextBlock Text="Voice:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <ComboBox ItemsSource="{Binding SyntaxVoiceOptions}" SelectedItem="{Binding OutputVoiceFilter}" Width="86" Margin="0,0,10,4" />
                    <Button Content="Generate Corpus" Command="{Binding GenerateBatchCommand}" Background="#0F172A" Foreground="White" Margin="0,0,6,4" />
                    <Button Content="Export TXT..." Click="OnExportTxtClick" Margin="0,0,6,4" />
                    <Button Content="Export CSV..." Click="OnExportCsvClick" Margin="0,0,0,4" />
                </WrapPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="138" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Text="{Binding BatchOutputText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="15" TextWrapping="Wrap" Padding="10" Background="#F8FAFC" Margin="0,0,0,8" />
                    <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding ActiveWritingSystemName}" FontWeight="SemiBold" FontSize="11" Foreground="#3730A3" />
                                </Border>
                                <TextBlock Text="{Binding OutputScriptSource}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
                                <ItemsControl ItemsSource="{Binding OutputScriptGlyphs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding DataContext.OutputScriptCanvasWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Height="{Binding DataContext.OutputScriptCanvasHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Background="Transparent" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.LayoutTransform>
                                                    <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                                                </Grid.LayoutTransform>
                                                <Canvas Width="100" Height="100">
                                                    <Path Data="{Binding PathGeometry}"
                                                          Stroke="#0F172A"
                                                          StrokeThickness="4.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                    <ItemsControl ItemsSource="{Binding ExtraGeometries}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas Width="100" Height="100" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Path Data="{Binding}"
                                                                      Stroke="#1E293B"
                                                                      StrokeThickness="4"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Canvas>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </GroupBox>

        <!-- Bottom Full Width: Discourse & Narrative Paragraph Generator -->
        <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="Discourse &amp; Narrative Paragraph Generator (Multi-Sentence Coherence, Definiteness &amp; Anaphora)">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Sentences:" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <TextBox Text="{Binding DiscourseSentenceCount, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,8,2"/>
                        <TextBlock Text="Words/Cl:" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <TextBox Text="{Binding DiscourseApproxWords, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,0,2"/>
                    </WrapPanel>
                    <CheckBox Content="Selectional Restrictions" IsChecked="{Binding DiscourseUseSemantics}" Margin="0,4"/>
                    <CheckBox Content="Track Definiteness (a → the)" IsChecked="{Binding DiscourseTrackDefiniteness}" Margin="0,4"/>
                    <CheckBox Content="Anaphoric Pronouns" IsChecked="{Binding DiscourseUsePronouns}" Margin="0,4"/>
                    <CheckBox Content="Connectives &amp; Coordination" IsChecked="{Binding DiscourseUseConnectives}" Margin="0,4"/>
                    <Button Content="Generate Discourse Paragraph" Command="{Binding GenerateDiscourseCommand}" Background="#2D7D9A" Foreground="White" FontWeight="Bold" Margin="0,10,0,4" Padding="8,5"/>
                    <TextBlock Text="Tracked Entities:" FontWeight="SemiBold" Margin="0,6,0,2"/>
                    <TextBox Height="50" IsReadOnly="True" Text="{Binding DiscourseEntitiesSummary}" Background="#252526" Foreground="#9CDCFE" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding DiscourseParagraphText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="15" TextWrapping="Wrap" Padding="8" Background="#F8FAFC"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
