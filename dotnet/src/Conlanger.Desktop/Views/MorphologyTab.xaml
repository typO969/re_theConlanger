<UserControl x:Class="Conlanger.Desktop.Views.MorphologyTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Conlanger.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="720" d:DesignWidth="1220">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.25*" />
        </Grid.ColumnDefinitions>

        <!-- Lexicon Editor -->
        <GroupBox Grid.Row="0" Grid.Column="0" Header="Lexicon (UR, Class, Deep Spelling &amp; Irregulars)" Margin="0,0,10,10">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Lemma:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding NewLexLemma, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,6,4" />
                    <TextBlock Text="POS:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding NewLexPos, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,6,4" />
                    <TextBlock Text="Class:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding NewLexClass, UpdateSourceTrigger=PropertyChanged}" Width="54" ToolTip="Lexical / Gender Class (e.g. Fem, Masc, Anim, C1)" Margin="0,0,6,4" />
                    <TextBlock Text="UR:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding NewLexUr, UpdateSourceTrigger=PropertyChanged}" Width="88" Margin="0,0,6,4" />
                    <TextBlock Text="Spelling:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding NewLexSpelling, UpdateSourceTrigger=PropertyChanged}" Width="66" ToolTip="Deep/Morphophonemic Spelling" Margin="0,0,6,4" />
                    <TextBlock Text="Irreg:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding NewLexIrregulars, UpdateSourceTrigger=PropertyChanged}" Width="125" ToolTip="Format: Number=Pl -> ˈm aɪ s; Tense=Past -> ˈw ɛ n t" Margin="0,0,6,4" />
                    <Button Content="+ Lexeme" Command="{Binding AddLexemeCommand}" Margin="0,0,0,4" />
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Lexemes}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lemma" Binding="{Binding Lemma}" Width="72" />
                        <DataGridTextColumn Header="POS" Binding="{Binding Pos}" Width="44" />
                        <DataGridTextColumn Header="Class" Binding="{Binding LexClass}" Width="56" />
                        <DataGridTextColumn Header="UR (Phones)" Binding="{Binding UR}" Width="*" />
                        <DataGridTextColumn Header="Spelling" Binding="{Binding Spelling}" Width="68" />
                        <DataGridTextColumn Header="Irregulars" Binding="{Binding IrregularsSummary, UpdateSourceTrigger=LostFocus}" Width="1.15*" />
                        <DataGridTemplateColumn Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="×" Padding="4,1" Margin="0"
                                            Command="{Binding DataContext.RemoveLexemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- Affixes Editor -->
        <GroupBox Grid.Row="0" Grid.Column="1" Header="Inflectional, Conditioned &amp; Non-Linear Morphology (Prefix/Suffix/Infix/Circumfix/Template)" Margin="0,0,0,10">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Text="{Binding NewAffixName, UpdateSourceTrigger=PropertyChanged}" Width="76" ToolTip="Rule Name" Margin="0,0,4,4" />
                    <TextBox Text="{Binding NewAffixPos, UpdateSourceTrigger=PropertyChanged}" Width="38" ToolTip="POS" Margin="0,0,4,4" />
                    <TextBox Text="{Binding NewAffixFeatName, UpdateSourceTrigger=PropertyChanged}" Width="64" ToolTip="Feature Name (e.g. Number, Class, Template)" Margin="0,0,4,4" />
                    <TextBox Text="{Binding NewAffixFeatVal, UpdateSourceTrigger=PropertyChanged}" Width="50" ToolTip="Feature Value" Margin="0,0,4,4" />
                    <TextBox Text="{Binding NewAffixForm, UpdateSourceTrigger=PropertyChanged}" Width="72" ToolTip="Form / Template (e.g. -i, um, ge+...+t, C1 a C2 a C3 a)" Margin="0,0,4,4" />
                    <TextBox Text="{Binding NewAffixCondition, UpdateSourceTrigger=PropertyChanged}" Width="82" ToolTip="Condition (e.g. [+sibilant], [-voice], [class=Fem])" Margin="0,0,4,4" />
                    <ComboBox ItemsSource="{Binding AffixTypes}" SelectedItem="{Binding NewAffixType}" Width="84" ToolTip="Morphology Kind" Margin="0,0,6,4" />
                    <Button Content="+ Affix" Command="{Binding AddAffixCommand}" Margin="0,0,0,4" />
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Affixes}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="34" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="86" />
                        <DataGridTextColumn Header="POS" Binding="{Binding Pos}" Width="40" />
                        <DataGridTextColumn Header="Feature" Binding="{Binding FeatureName}" Width="66" />
                        <DataGridTextColumn Header="Value" Binding="{Binding FeatureValue}" Width="50" />
                        <DataGridTextColumn Header="Form / Pattern" Binding="{Binding Affix}" Width="78" />
                        <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="*" />
                        <DataGridTemplateColumn Header="Kind" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.AffixTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding EffectiveAffixType, UpdateSourceTrigger=PropertyChanged}"
                                              Padding="4,1" BorderThickness="0" Background="Transparent" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Order" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="↑" Padding="4,1" Margin="0,0,2,0"
                                                Command="{Binding DataContext.MoveAffixUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="↓" Padding="4,1" Margin="0,0,2,0"
                                                Command="{Binding DataContext.MoveAffixDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="×" Padding="4,1" Margin="0"
                                                Command="{Binding DataContext.RemoveAffixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- Bottom: Live Morphology Realizer Preview -->
        <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="Live Morphology Realizer Preview (Respects Swapped Phase 4 Realizer)">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Lemma:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding MorphPreviewLemma, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,10,0" />
                <TextBlock Text="POS:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding MorphPreviewPos, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="0,0,10,0" />
                <TextBlock Text="Feature:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding MorphPreviewFeatName, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,6,0" />
                <TextBlock Text="=" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding MorphPreviewFeatVal, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,10,0" />
                <Button Content="Realize" Command="{Binding RefreshMorphPreviewCommand}" />
                <TextBlock Text="UR Realized:" VerticalAlignment="Center" Foreground="#475569" Margin="10,0,6,0" />
                <TextBlock Text="{Binding MorphPreviewOutput}" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="Consolas" FontSize="14" Foreground="#0F172A" />
            </WrapPanel>
        </GroupBox>
    </Grid>
</UserControl>
