<UserControl x:Class="Conlanger.Desktop.Views.WritingSystemsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Conlanger.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="680" d:DesignWidth="1180">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Layer 1 + Layer 2 Controls -->
        <GroupBox Grid.Row="0" Grid.ColumnSpan="2" Header="Layer 1 Input &amp; Layer 2 Flow Vector Controls">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Input Sequence:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding ShapingInput, UpdateSourceTrigger=PropertyChanged}" Width="240" Padding="5,3" Margin="0,0,14,0" />
                <TextBlock Text="Flow Vector:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding FlowDirections}" SelectedItem="{Binding SelectedFlowDirection}" Width="140" Margin="0,0,14,0" />
                <CheckBox Content="Cursive Anchor Bonding" IsChecked="{Binding CursiveBonding}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <CheckBox Content="Show Debug Anchors" IsChecked="{Binding ShowAnchors}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="Preset: RTL Cursive" Command="{Binding ApplyRtlPresetCommand}" />
                <Button Content="Preset: Vertical Spine" Command="{Binding ApplyWritingPresetCommand}" />
                <Button Content="Export SVG..." Click="OnExportSvgClick" />
            </WrapPanel>
        </GroupBox>

        <!-- Layer 3 Vector Canvas Renderer (100% Declarative WPF Vector Paths) -->
        <GroupBox Grid.Row="1" Grid.Column="0" Header="Layer 3: Agnostic Vector Shaping Canvas" Margin="0,0,10,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
                <ItemsControl ItemsSource="{Binding ShapedGlyphs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Background="White" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Path Data="{Binding PathGeometry}"
                                      Stroke="#0F172A"
                                      StrokeThickness="4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round">
                                    <Path.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                                    </Path.LayoutTransform>
                                </Path>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- Shaping Graph Trace -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Layer 2 Shaping Graph Execution Trace">
            <DataGrid ItemsSource="{Binding ShapingTrace}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Step}" Width="38" />
                    <DataGridTextColumn Header="Token" Binding="{Binding TokenId}" Width="65" />
                    <DataGridTextColumn Header="Variant" Binding="{Binding Variant}" Width="75" />
                    <DataGridTextColumn Header="Anchor / Strategy" Binding="{Binding AnchorMode}" Width="*" />
                    <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="85" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
