<UserControl x:Class="Conlanger.Desktop.Views.EvolutionTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="650" d:DesignWidth="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Presets and Evolution Controls Header -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Diachronic Evolution Presets:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox Width="240" ItemsSource="{Binding DiachronicPresets}" SelectedValuePath="Id" DisplayValuePath="Name" SelectedValue="{Binding SelectedDiachronicPresetId}" Margin="0,0,12,0"/>
                <Button Content="Load (Replace)" Command="{Binding LoadDiachronicPresetReplaceCommand}" Margin="0,0,8,0" Padding="8,4"/>
                <Button Content="Load (Append)" Command="{Binding LoadDiachronicPresetAppendCommand}" Margin="0,0,24,0" Padding="8,4"/>
                <Button Content="Simulate Evolution" Command="{Binding SimulateEvolutionCommand}" Background="#2D7D9A" Foreground="White" Padding="10,5" FontWeight="Bold"/>
            </WrapPanel>
        </Border>

        <!-- Split Content: Rules List & Sandbox Tracer / Diff Tables -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Diachronic Rules Sequence -->
            <GroupBox Grid.Column="0" Header="Ordered Sound Change Laws" Margin="0,0,8,0" Foreground="White">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding DiachronicRulesCollection}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#1E1E1E" Foreground="White" RowBackground="#252526" AlternatingRowBackground="#2D2D30">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="En" Binding="{Binding Enabled}"/>
                            <DataGridTextColumn Header="Rule Name" Binding="{Binding Name}" Width="120"/>
                            <DataGridTextColumn Header="Era" Binding="{Binding Era}" Width="50"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="60"/>
                            <DataGridTextColumn Header="Repl" Binding="{Binding Replacement}" Width="60"/>
                            <DataGridTextColumn Header="Prev" Binding="{Binding PrevPhone}" Width="50"/>
                            <DataGridTextColumn Header="Next" Binding="{Binding NextPhone}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Add Rule Bar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBox Width="90" Text="{Binding NewDiachronicName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rule Name" Margin="0,0,4,0"/>
                        <TextBox Width="45" Text="{Binding NewDiachronicEra, UpdateSourceTrigger=PropertyChanged}" ToolTip="Era" Margin="0,0,4,0"/>
                        <TextBox Width="45" Text="{Binding NewDiachronicTarget, UpdateSourceTrigger=PropertyChanged}" ToolTip="Target" Margin="0,0,4,0"/>
                        <TextBox Width="45" Text="{Binding NewDiachronicReplacement, UpdateSourceTrigger=PropertyChanged}" ToolTip="Replacement" Margin="0,0,4,0"/>
                        <Button Content="Add Rule" Command="{Binding AddDiachronicRuleCommand}" Padding="8,3"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Move Up" Command="{Binding MoveDiachronicRuleUpCommand}" Margin="0,0,8,0" Padding="6,2"/>
                        <Button Content="Move Down" Command="{Binding MoveDiachronicRuleDownCommand}" Margin="0,0,8,0" Padding="6,2"/>
                        <Button Content="Remove" Command="{Binding RemoveDiachronicRuleCommand}" Foreground="#FF6B6B" Padding="6,2"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Right: Proto-Form Sandbox Tracer & Diffs -->
            <TabControl Grid.Column="1" Background="#1E1E1E">
                <TabItem Header="Proto Sandbox Tracer" Foreground="White">
                    <StackPanel Margin="8">
                        <TextBlock Text="Trace Proto-Form Sound Laws Step-by-Step:" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Width="220" Text="{Binding ProtoTestUr, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Proto-Ur (e.g. *ˈk n iː x t)"/>
                            <Button Content="Trace Steps" Command="{Binding TraceProtoFormCommand}" Padding="10,3" Margin="0,0,8,0"/>
                            <Button Content="Sample Knight" Command="{Binding LoadProtoSampleKnightCommand}" Padding="6,3" Margin="0,0,4,0"/>
                            <Button Content="Mouse" Command="{Binding LoadProtoSampleMouseCommand}" Padding="6,3"/>
                        </StackPanel>
                        <TextBox Height="180" IsReadOnly="True" Text="{Binding ProtoTraceOutput}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#252526" Foreground="#4EC9B0" FontFamily="Consolas" Padding="6"/>

                        <TextBlock Text="Emergent &amp; Lost Phones Summary:" Foreground="White" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBox Height="70" IsReadOnly="True" Text="{Binding EvolutionDeltaSummary}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#252526" Foreground="#DCDCAA" FontFamily="Consolas" Padding="4"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Cognate &amp; Affix Diffs" Foreground="White">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding DiachronicCognateDiffs}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#1E1E1E" Foreground="White" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lemma" Binding="{Binding ProtoLemma}" Width="90"/>
                                <DataGridTextColumn Header="Proto UR" Binding="{Binding ProtoUr}" Width="100"/>
                                <DataGridTextColumn Header="Daughter UR" Binding="{Binding DaughterUr}" Width="110"/>
                                <DataGridTextColumn Header="Surface" Binding="{Binding DaughterSurface}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding DiffStatus}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DiachronicAffixDiffs}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#1E1E1E" Foreground="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Affix Name" Binding="{Binding AffixName}" Width="110"/>
                                <DataGridTextColumn Header="Proto Form" Binding="{Binding ProtoForm}" Width="110"/>
                                <DataGridTextColumn Header="Daughter Form" Binding="{Binding DaughterForm}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Bottom: Apply Evolution to Fork Project -->
        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Daughter Language Name:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="180" Text="{Binding DaughterLanguageName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <CheckBox Content="Preserve historical pre-shift spellings (Morphophonemic)" IsChecked="{Binding PreserveHistoricalSpelling}" Foreground="White" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <Button Content="Apply Evolution (Fork Project)" Command="{Binding ApplyEvolutionCommand}" Background="#0E639C" Foreground="White" FontWeight="Bold" Padding="12,6"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
